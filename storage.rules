rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Preuves ──────────────────────────────────────────────────────────
    // Lecture publique (URLs de téléchargement directes)
    // Écriture : authentifié, chemin valide preuves/{userId}/{filename}
    match /preuves/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 52428800   // 50 Mo max
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('video/.*')
                   );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bloquer tout accès non explicitement autorisé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
